# ============================================================
# 自动更新忽略清单
# ============================================================
#
# 这些文件不会进入服务端 manifest，
# 客户端也不会覆盖。
#
# 支持：
# *  当前目录通配
# ** 跨目录通配
# ?  单个字符
#
# 下面只是示例，请按你的软件实际情况修改。


# 客户本机配置
config.ini
config/*.json

# 运行日志
logs/**
*.log

# 客户运行过程中产生的数据
data/local/**

# 临时文件
temp/**
cache/**

# 注意：
# updater/**
# version.txt
# .update-temp/**
# .update-backup/**
# 已经由平台默认忽略，不需要重复填写。
